{
  "name": "boardwfriends",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @bwf/web dev",
    "build": "pnpm --filter @bwf/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs",
    "lan": "pnpm build && pnpm --filter @bwf/lan-server build && node apps/lan-server/dist/server.mjs",
    "lan:start": "node apps/lan-server/dist/server.mjs",
    "voice": "pnpm --filter @bwf/lan-server build && node apps/lan-server/dist/voice.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "cf:deploy": "pnpm --filter @bwf/web run cf:deploy"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
